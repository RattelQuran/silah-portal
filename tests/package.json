{
  "name": "silah-portal-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "rules": "firebase emulators:exec --project demo-silah --only firestore --config ../firebase.json \"node --test rules.test.mjs\"",
    "e2e": "node --test --test-concurrency=1 e2e.test.mjs",
    "unit": "node --test unit.test.mjs",
    "test": "npm run unit && npm run rules && npm run emulator && npm run appcheck && npm run e2e",
    "emulator": "firebase emulators:exec --project demo-silah --only auth,firestore --config ../firebase.json \"node --test --test-concurrency=1 emulator.test.mjs\"",
    "appcheck": "firebase emulators:exec --project demo-silah --only auth,firestore --config ../firebase.json \"node --test --test-concurrency=1 appcheck.test.mjs\"",
    "emulator:appcheck": "SILAH_APPCHECK=1 npm run emulator"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "firebase": "10.12.2",
    "firebase-tools": "13.35.1",
    "playwright": "1.56.1"
  }
}
